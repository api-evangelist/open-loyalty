{
  "opencollection": "1.0.0",
  "info": {
    "name": "Open Loyalty REST Authorization Earning Rules API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
