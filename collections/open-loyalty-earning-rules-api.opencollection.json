            "params": [
              {
                "name": "storeCode",
                "value": "",
                "type": "path",
                "description": "The store the request is scoped to."
              },
              {
                "name": "earningRule",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get an earning rule"
