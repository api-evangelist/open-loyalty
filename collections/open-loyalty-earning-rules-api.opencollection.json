              {
                "name": "storeCode",
                "value": "",
                "type": "path",
                "description": "The store the request is scoped to."
              },
              {
                "name": "earningRule",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
