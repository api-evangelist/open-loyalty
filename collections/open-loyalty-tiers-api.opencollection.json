          "http": {
            "method": "PUT",
            "url": "https://{instance}.openloyalty.io/api/:storeCode/level/:level",
            "params": [
              {
                "name": "storeCode",
                "value": "",
                "type": "path",
                "description": "The store the request is scoped to."
              },
              {
                "name": "level",
                "value": "",
                "type": "path",
                "description": "Level (tier) identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a level (tier)"
