              {
                "name": "level",
                "value": "",
                "type": "path",
                "description": "Level (tier) identifier."
              }
            ]
          },
          "docs": "Get a level (tier)"
        },
        {
          "info": {
            "name": "Update a level (tier)",
            "type": "http"
